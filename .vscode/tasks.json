      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    },
    {
      "label": "🗄️ DB: Reset Database",
      "type": "shell",
      "command": "./scripts/db-utils.sh reset",
      "windows": {
        "command": "powershell -ExecutionPolicy Bypass -File .\\scripts\\db-utils.ps1 reset"
