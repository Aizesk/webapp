    {
      "label": "🐳 Docker: Start Infrastructure",
      "type": "shell",
      "command": "./start-deployment-docker.sh infra",
      "windows": {
        "command": "powershell -ExecutionPolicy Bypass -File .\\start-deployment-docker.ps1 infra"
      },
      "options": {
        "cwd": "${workspaceFolder}/local-deployment"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🐳 Docker: Start ALL (Infra + Services)",
      "type": "shell",
      "command": "./start-deployment-docker.sh all",
