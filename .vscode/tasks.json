    {
      "label": "Frontend: Start Angular",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": {
          "regexp": ".",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "bundle generation complete|Compiled successfully"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "frontend"
      }
    },
    {
      "label": "MS: auth-service (8081)",
